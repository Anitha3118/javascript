<body>
    <script>
        //task1
        let arr1 = [1,2,3,4,5];
        let [first,b,c,d,last] = arr1;
        console.log("task1");
        console.log("First element: " + first);
        console.log("Last Element: " + last);

        //task2
        let arr2 = [100,200,300];
        let [x, ,z] = arr2;
        console.log("task2:");
        console.log("First Value: " + x);
        console.log("Third value: " + z);

        //task3
        let arr3 = [1,2,3,4,5];
        let [a, ...rest] = arr3;
        console.log("task3:");
        console.log("First Element: " + a);
        console.log("Rest Elements: ");
        console.log(rest);

        //task4
        let a1 = [1,2];
        let b1 = [3,4];
        let merged = [...a1,...b1];
        console.log("task4:");
        console.log(merged);

        //task5
        let original = [10,20,30];
        let copied = [...original];
        console.log("task5: Copied Array");
        console.log(copied);

        //task6
        let product = {
           id: 1,
           name: "Mobile",
           price: 15000
        };
        let { name, price} = product;
        console.log("task6:");
        console.log("Name: " + name);
        console.log("Price: " + price);

        //task7
        let user = { name: "anitha", age: 22 };
        let {name: fullName} = user;
        console.log("task7: ");
        console.log("Full Name: " + fullName);

        //task8
        let student = {
          marks: {
             math: 92,
             science: 98
            }
        };
        let {marks: {math, science}} = student;
        console.log("task8: ");
        console.log("Math: " + math);
        console.log("Science: " + science);

        //task9
        function show({name, age})
        {
            console.log("Name: " + name);
            console.log("Age: " + age);
        }
        let user2 = { name: "anitha", age: 22};
        console.log("task9: ");
        show(user2);

        //task10
        let arr4 = [10,20,30,40];
        let [ , ...restElements] = arr4;
        let newArray = [100,200, ...restElements];
        console.log("task10: ");
        console.log(newArray);

    </script>
</body>
