<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> Event Listener </title>
</head>
<body>
    <!-- task1 -->
    <h2>task1:</h2>
    <button id="btn1">Click me to see the count</button>
    <p id="result"></p>

    <!-- task2 -->
    <h2>task2:</h2>
    <button id="btn2">Click me to change the paragraph text</button>
    <p id="changeText">Hello, World!</p>

    <!-- task3 -->
    <h2>task3:</h2>
    <button id="darkBtn">Dark Mode</button>
    <style>
        .dark{
            background-color: black;
            color: white;
        }
    </style>

    <!-- task4 -->
    <h2>task4:</h2>
    <div id="box" style="background-color: palegreen; width: 150px; height: 100px;">Mouse Over me</div>
    
    <!-- task5 -->
    <h2>task5:</h2>
    <input type="text" id="inputBox" placeholder="Type something">
    <p id="res"></p>


    <script>
        //task1
        let counter = 0;
        document.getElementById("btn1").addEventListener("click", function(){
            counter++;
            document.getElementById("result").innerHTML = "Click count: " + counter;
        });

        //task2
        document.getElementById("btn2").addEventListener("click", function(){
            document.getElementById("changeText").innerHTML = "Hello, Javascript!";
        });

        //task3
        document.getElementById("darkBtn").addEventListener("click", function(){
            document.body.classList.toggle("dark");
        });

        //task4
        let box = document.getElementById("box");
        box.addEventListener("mouseenter", function(){
            box.style.backgroundColor = "red";
        });
        box.addEventListener("mouseleave", function(){
            box.style.backgroundColor = "palegreen";
        });

        //task5
        document.getElementById("inputBox").addEventListener("input", function(){
            document.getElementById("res").innerHTML = "Input box: "+ this.value;
        });

    </script>
