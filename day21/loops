<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>For Loop Programs</title>
</head>
<body>
<script>
    // FOR LOOP
    console.log("FOR LOOP")
    // task12: Factorial of a given number
    // 5! = 5 * 4 * 3 * 2 * 1 = 120

    let n12 = Number(prompt("Enter the number to find a factorial"));
    let fact = 1;

    for(let i = n12; i >= 1; i--)
    {
        fact = fact * i;
    }

    console.log("task12:", n12 + "! =", fact);


    // task13: Find out the given number is Prime or Not

    let n13 = Number(prompt(" Enter the number to find prime or not"));
    let ctr = 0;

    for(let i = 1; i <= n13; i++)
    {
        if(n13 % i == 0)
        {
            ctr++;
        }
    }

    if(ctr == 2)
    {
        console.log("task13:", n13 + " is a prime number");
    }
    else
    {
        console.log("task13:", n13 + " is not a prime number");
    }

    // task14: Print the Prime Number Series

    let s14 = "";
    
    for(let n = 1; n <= 100; n++)
    {
        let ctr = 0;

        for(let i = 1; i <= n; i++)
        {
            if(n % i == 0)
            {
                ctr++;
            }
        }

        if(ctr == 2)
        {
            s14 = s14 + n + " ";
        }
    }

    console.log("task14:", s14);

    // task15: Find out the given number is Armstrong or Not
    // 153 = 1^3 + 5^3 + 3^3 = 153

    let n15 = Number(prompt("Enter the number to find amstrong or not"));
    let temp15 = n15;
    let sum15 = 0;
    let r15;

    for(; temp15 > 0; temp15 = parseInt(temp15 / 10))
    {
        r15 = temp15 % 10;
        sum15 = sum15 + r15 * r15 * r15;
    }

    if(sum15 == n15)
    {
        console.log("task15:", n15 + " is an Armstrong number");
    }
    else
    {
        console.log("task15:", n15 + " is not an Armstrong number");
    }

    // task16: Print the Armstrong Number Series
    let s16 = "";

    for(let n = 1; n <= 1000; n++)
    {
        let temp = n;
        let sum = 0;
        let r;

        for(; temp > 0; temp = parseInt(temp / 10))
        {
            r = temp % 10;
            sum = sum + r * r * r;
        }

        if(sum == n)
        {
            s16 = s16 + n + " ";
        }
    }

    console.log("task16:", s16);


    // task17: Fibonacci Series
    // 0 1 1 2 3 5 8 13.....

    let s17 = "";
    let a = 0;
    let b = 1;

    for(let i = 1; i <= 10; i++)
    {
        s17 = s17 + a + " ";

        let c = a + b;
        a = b;
        b = c;
    }

    console.log("task17:", s17);


    // task18: Print the 5 Table
    // 1 * 5 = 5

    let s18 = "";

    for(let i = 1; i <= 10; i++)
    {
        s18 = s18 + i + " * 5 = " + (i * 5) + "\n";
    }

    console.log("task18:\n" + s18);


    // task19: Sum of Digits
    // Example: 123 = 1 + 2 + 3 = 6

    let n19 = Number(prompt("Enter the number to find sum of digits"));
    let temp19 = n19;
    let sum19 = 0;
    let r19;

    for(; temp19 > 0; temp19 = parseInt(temp19 / 10))
    {
        r19 = temp19 % 10;
        sum19 = sum19 + r19;
    }

    console.log("task19:", n19 + " = " + sum19);

    // task20: Palindrome or Not
    // BAAB, MALAYALAM, MADAM

    let n20 = prompt("Enter the word to find palindrome or not");
    let reverse20 = "";

    for(let i = n20.length - 1; i >= 0; i--)
    {
        reverse20 = reverse20 + n20[i];
    }

    if(n20.toLowerCase() == reverse20.toLowerCase())
    {
        console.log("task20:", n20 + " is a palindrome");
    }
    else
    {
        console.log("task20:", n20 + " is not a palindrome");
    }
</script>
</body>
</html>
